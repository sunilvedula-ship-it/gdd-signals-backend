SQUARE_OFF_SECRET=

# Alice Blue creates these after approving the Vendor API application.
ALICEBLUE_APP_CODE=
ALICEBLUE_API_SECRET=
ALICEBLUE_ALGO_ID=
ALICEBLUE_API_ORDER_SOURCE=API
ALICEBLUE_DEVICE_ID=GDD-MOBILE
